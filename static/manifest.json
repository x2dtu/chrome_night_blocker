{
  "manifest_version": 3,
  "name": "Night Blocker",
  "short_name": "Night Blocker",
  "version": "0.1.0",
  "description": "Block distracting websites on a schedule, with hard, soft and reminder modes.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "webNavigation",
    "idle",
    "declarativeNetRequest"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
